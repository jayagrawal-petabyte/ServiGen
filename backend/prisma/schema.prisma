// ─── Prisma Schema for Halo AI / ServiGen ──────────────────────────────────
// PostgreSQL & Supabase Compatible

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// ─── Organisation & Multi-Tenancy ──────────────────────────────────────────

model Organisation {
  id                    String                 @id @default(uuid())
  name                  String
  domain                String?                @unique
  tier                  String                 @default("Standard")
  sites                 Site[]
  users                 User[]
  tickets               Ticket[]
  majorIncidents        MajorIncident[]
  approvals             Approval[]
  configurationItems    ConfigurationItem[]
  changeRequests        ChangeRequest[]
  projects              Project[]
  knowledgeArticles     KnowledgeArticle[]
  serviceCatalogueItems ServiceCatalogueItem[]
  customLists           CustomList[]
  teams                 Team[]
  agentMoods            AgentMood[]
  calendarEvents        CalendarEvent[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  ticketNotes           TicketNote[]
  ticketLinks           TicketLink[]
  ticketTimeEntries TicketTimeEntry[]
  @@map("organisations")
}

model Site {
  id                 String              @id @default(uuid())
  name               String
  timezone           String              @default("UTC")
  organisationId     String
  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  users              User[]
  configurationItems ConfigurationItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("sites")
}

// ─── Users & RBAC ──────────────────────────────────────────────────────────

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  username         String?      @unique
  phoneNumber      String?
  networkLogin     String?
  availability     String       @default("Available")
  teamMemberships  TeamMembership[]
  calendarEvents   CalendarEvent[]
  assignedChanges  ChangeRequest[]
  customLists      CustomList[]
  authoredArticles KnowledgeArticle[]
  passwordHash     String
  firstName        String
  lastName         String
  role             String       @default("Service User") // "Service User", "Service Agent", "Approver", "Support Team User", "Admin"
  organisationId   String?
  organisation     Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  siteId           String?
  site             Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  assignedTickets  Ticket[]     @relation("AssignedAgent")
  requestedTickets Ticket[]     @relation("Requester")
  approvals        Approval[]   @relation("Approver")
  moodEntries      AgentMood[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  authoredTicketNotes TicketNote[]
  createdTicketLinks TicketLink[] @relation("TicketLinkCreator")
  resolvedTickets Ticket[] @relation("TicketResolvedBy")
  loggedTicketTimeEntries TicketTimeEntry[] @relation("TicketTimeEntryAgent")
  ownedProjects Project[] @relation("ProjectOwner")
  projectResourceAssignments ProjectResourceAssignment[]
  @@map("users")
}

// ─── Core Service Management (Tickets) ─────────────────────────────────────

model Ticket {
  id              String          @id // e.g., "INC-1001", "REQ-1002"
  summary         String
  description     String?         @db.Text
  ticketType      String          // "Incident", "Service Request", "Major Incident"
  priority        String          // "Critical", "High", "Medium", "Low", "P1", "P2"
  status          String          @default("Active") // "Active", "Pending", "Actioned", "On Hold", "Resolved", "Closed"
  organisationId  String?
  organisation    Organisation?   @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  siteName        String?         // Denormalized site name for fast list rendering
  requesterId     String?
  requester       User?           @relation("Requester", fields: [requesterId], references: [id], onDelete: SetNull)
  assignedAgentId String?
  assignedAgent   User?           @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  teamId          String?
  team            Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedTeam    String?         // "1st Line Support", "2nd Line Support", "Major Incidents"
  slaTimeLeft     Int?            // Remaining minutes before SLA breach
  timeRecord      Int             @default(0) // Cumulative logged minutes spent
  reopenCount     Int             @default(0) // Times ticket transitioned from Resolved/Closed back to Active
  holdReason      String?
  holdStartedAt   DateTime?
  responseTargetAt     DateTime?
  resolutionTargetAt   DateTime?
  responseMetAt        DateTime?
  incident        Incident?
  serviceRequest  ServiceRequest?
  approvals       Approval[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  notes           TicketNote[]
  outgoingLinks TicketLink[] @relation("TicketLinkSource")
  incomingLinks TicketLink[] @relation("TicketLinkTarget")
  resolutionCode     String?
  resolutionNotes    String?   @db.Text
  rootCauseSummary   String?   @db.Text
  resolvedAt         DateTime?
  resolvedById       String?
  resolvedBy         User?     @relation("TicketResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  timeEntries TicketTimeEntry[]
  @@index([assignedAgentId, status])
  @@index([organisationId])
  @@map("tickets")
}

// ─── Incidents & Major Incidents ───────────────────────────────────────────

model Incident {
  id            String         @id @default(uuid())
  ticketId      String         @unique
  ticket        Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  category      String         @default("General") // "Network", "Hardware", "Software", "Access & Identity", etc.
  impact        String         @default("Low")
  urgency       String         @default("Low")
  majorIncident MajorIncident?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("incidents")
}

model MajorIncident {
  id               String                @id // e.g., "MI-1001"
  organisationId   String?
  organisation     Organisation?         @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  incidentId       String?               @unique
  incident         Incident?             @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  title            String
  description      String                @db.Text
  priority         String                // "P1", "P2"
  status           String                @default("Started") // "Started", "Escalated", "Diagnosed", "Mitigated", "Resolved", "Closed"
  impact           String
  affectedServices String[]              // List of affected service names
  responseTargetAt DateTime?
  resolutionTargetAt DateTime?
  updateDueAt      DateTime? // Update Required is derived from this deadline
  productTags      String[]              @default([])
  commander        String                @default("Unassigned")
  startedAt        DateTime              @default(now())
  resolvedAt       DateTime?
  updates          MajorIncidentUpdate[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([organisationId, status])
  @@map("major_incidents")
}

model MajorIncidentUpdate {
  id              String        @id @default(uuid())
  majorIncidentId String
  majorIncident   MajorIncident @relation(fields: [majorIncidentId], references: [id], onDelete: Cascade)
  message         String        @db.Text
  author          String        @default("Commander")
  timestamp       DateTime      @default(now())

  @@map("major_incident_updates")
}

// ─── Service Catalogue & Service Requests ──────────────────────────────────

model ServiceCatalogueItem {
  id               String           @id @default(uuid())
  organisationId   String?
  organisation     Organisation?    @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  name             String
  description      String           @db.Text
  category         String           // "Hardware", "Software Access", "Cloud Resources"
  status           String           @default("Active")
  icon             String?
  requiresApproval Boolean          @default(false)
  formFields       Json?            @default("[]")
  serviceRequests  ServiceRequest[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([organisationId, status])
  @@map("service_catalogue_items")
}

model ServiceRequest {
  id                     String               @id @default(uuid())
  ticketId               String               @unique
  ticket                 Ticket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  serviceCatalogueItemId String
  serviceCatalogueItem   ServiceCatalogueItem @relation(fields: [serviceCatalogueItemId], references: [id], onDelete: Restrict)
  approvals              Approval[]
  requestedData          Json?                @default("{}")
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@map("service_requests")
}

// ─── Approvals ─────────────────────────────────────────────────────────────

model Approval {
  id         String    @id // e.g., "APP-1001"
  organisationId String?
  organisation   Organisation?   @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  ticketId   String?
  ticket     Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  entityType String    // "Service Request", "Change Request"
  entityId   String    // Legacy target identifier; use typed relations below for integrity
  serviceRequestId String?
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  changeRequestId String?
  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: Restrict)
  summary    String
  status     String    @default("Pending") // "Pending", "Approved", "Rejected"
  approverId String?
  approver   User?     @relation("Approver", fields: [approverId], references: [id], onDelete: SetNull)
  comments   String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([organisationId, status])
  @@index([approverId, status])
  @@map("approvals")
}

// ─── CMDB & Configuration Items ────────────────────────────────────────────

model ConfigurationItem {
  id             String          @id // e.g., "CI-001"
  organisationId String?
  organisation   Organisation?   @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  name           String
  type           String          // "Server", "Database", "Application", "Network"
  tag            String          @unique // "PAY-001", "DB-001"
  siteId         String?
  site           Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteName       String?         // Denormalized site name
  status         String          @default("Active")
  businessOwner  String?
  changeRequests ChangeRequest[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  ticketLinks TicketLink[]
  @@index([organisationId, status])
  @@map("configuration_items")
}

// ─── Change Requests ───────────────────────────────────────────────────────

model ChangeRequest {
  id                  String             @id // e.g., "CR-001"
  organisationId      String?
  organisation        Organisation?      @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  summary             String
  changeType          String             // "Standard", "Normal", "Emergency"
  status              String             @default("Active") // "Draft", "Pending Approval", "Approved", "Active", "Scheduled", "Completed", "Rejected"
  ciId                String?
  configurationItem   ConfigurationItem? @relation(fields: [ciId], references: [id], onDelete: SetNull)
  ciTag               String?            // Denormalized tag e.g. "PAY-001"
  assignedAgentId     String?
  assignedAgent       User? @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  approvals           Approval[]
  relatedService      String?
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([organisationId, status])
  @@map("change_requests")
}

// ─── Projects & Tasks ──────────────────────────────────────────────────────

model Project {
  id                 String                    @id // e.g., "P-001"
  organisationId     String?
  organisation       Organisation?              @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  name               String
  description        String?                    @db.Text
  code               String
  status             String                    @default("ACTIVE")
  priority           String?
  startDate          DateTime?
  endDate            DateTime?
  timeSpent          Int                       @default(0)
  ownerId            String?
  owner              User?                     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  subtasks           ProjectSubtask[]
  resourceAssignments ProjectResourceAssignment[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([organisationId, code])
  @@index([organisationId, status])
  @@index([ownerId])
  @@map("projects")
}

model ProjectSubtask {
  id           String                      @id // e.g., "ST-001"
  projectId    String
  project      Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  status       String                      @default("PENDING")
  dependencies  ProjectSubtaskDependency[]   @relation("SubtaskDependencies")
  dependents    ProjectSubtaskDependency[]   @relation("SubtaskDependents")
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@map("project_subtasks")
}

model ProjectSubtaskDependency {
  id                String        @id @default(uuid())
  subtaskId         String
  subtask           ProjectSubtask @relation("SubtaskDependencies", fields: [subtaskId], references: [id], onDelete: Cascade)
  dependsOnSubtaskId String
  dependsOnSubtask  ProjectSubtask @relation("SubtaskDependents", fields: [dependsOnSubtaskId], references: [id], onDelete: Cascade)
  dependencyType    String        @default("FINISH_TO_START")
  lagTime           Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([subtaskId, dependsOnSubtaskId])
  @@index([subtaskId])
  @@index([dependsOnSubtaskId])
  @@map("project_subtask_dependencies")
}

model ProjectResourceAssignment {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocatedHours Float
  capacityHours  Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_resource_assignments")
}


// ─── List Builder (Custom Lists) ───────────────────────────────────────────

model CustomList {
  id             String        @id // e.g., "LIST-001"
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  status         String        @default("Draft")
  fields         String[] // Display column names
  filterCriteria Json?    @default("{}")
  scope          String?
  group          String?
  columnProfile  Json?
  sequence       Int      @default(0)
  displayType    String?
  createdById    String?
  creator        User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdBy      String   @default("Admin")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organisationId])
  @@map("custom_lists")
}

// ─── Agent Mood Tracker (Dashboard SCR-014) ────────────────────────────────

model AgentMood {
  id             String        @id @default(uuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  agentId        String
  agent          User          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  mood           String   // "Great", "Good", "Neutral", "Struggling", "Overwhelmed"
  submittedAt    DateTime @default(now())

  @@index([organisationId, submittedAt])
  @@map("agent_moods")
}

// Roles remain display-name strings for compatibility with existing modules.
// The shared permission layer validates them. Multi-role membership and
// cross-organisation access policy are not inferred from the functional document.
model Team {
  id             String           @id @default(uuid())
  organisationId String?
  organisation   Organisation?    @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  name           String           @unique
  memberships    TeamMembership[]
  tickets        Ticket[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organisationId])
  @@map("teams")
}
model TeamMembership {
  teamId String
  userId String
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([teamId, userId])
  @@index([userId])
  @@map("team_memberships")
}
model KnowledgeArticle {
  id             String                      @id @default(uuid())
  organisationId String?
  organisation   Organisation?               @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  title          String
  content        String                      @db.Text
  category       String?
  priority       String?
  status         String                      @default("Draft")
  approvalStatus String                      @default("Pending")
  slaDueAt       DateTime?
  authorId       String?
  author         User?                       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  embedding      Unsupported("vector(384)")?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([organisationId, status])
  @@map("knowledge_articles")
}
model CalendarEvent {
  id              String        @id @default(uuid())
  organisationId  String?
  organisation    Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  title           String
  appointmentType String
  startsAt        DateTime
  endsAt          DateTime
  agentId         String
  agent           User          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organisationId, startsAt])
  @@index([agentId, startsAt])
  @@map("calendar_events")
}
model TicketNote {
  id             String        @id @default(uuid())
  ticketId       String
  ticket         Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  authorId       String?
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName     String
  authorEmail    String?

  noteType       String
  content        String        @db.Text
  createdAt      DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@index([organisationId, createdAt])
  @@index([authorId])
  @@map("ticket_notes")
}
model TicketLink {
  id                 String             @id @default(uuid())

  ticketId           String
  ticket             Ticket             @relation("TicketLinkSource", fields: [ticketId], references: [id], onDelete: Cascade)

  relatedTicketId    String?
  relatedTicket      Ticket?            @relation("TicketLinkTarget", fields: [relatedTicketId], references: [id], onDelete: Cascade)

  problemId          String?

  configurationItemId String?
  configurationItem  ConfigurationItem? @relation(fields: [configurationItemId], references: [id], onDelete: Cascade)

  organisationId     String?
  organisation       Organisation?      @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  createdById        String?
  createdBy          User?              @relation("TicketLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  relationType       String
  createdAt          DateTime           @default(now())

  @@unique([ticketId, relatedTicketId, relationType])
  @@unique([ticketId, problemId, relationType])
  @@unique([ticketId, configurationItemId, relationType])
  @@index([organisationId, createdAt])
  @@index([relatedTicketId])
  @@index([configurationItemId])
  @@map("ticket_links")
}
model TicketTimeEntry {
  id              String        @id @default(uuid())

  ticketId        String
  ticket          Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  organisationId  String?
  organisation    Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  agentId         String?
  agent           User?         @relation("TicketTimeEntryAgent", fields: [agentId], references: [id], onDelete: SetNull)

  agentName       String
  agentEmail      String?

  durationMinutes Int
  description     String        @db.Text

  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@index([organisationId, createdAt])
  @@index([agentId, createdAt])
  @@map("ticket_time_entries")
}