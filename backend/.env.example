# ─── Server Configuration ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database Configuration (PostgreSQL / Supabase) ─────────────────────────
# For local Docker PostgreSQL (host port 5433; native PostgreSQL may use 5432):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/servigen?schema=public"

# For hosted Supabase PostgreSQL (Transaction Pooler or Direct):
# DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# A separate migration/direct URL must be configured in the Prisma datasource
# before using a transaction pooler; DIRECT_URL is not currently wired.

# ─── Authentication & JWT ───────────────────────────────────────────────────
# Required outside tests: generate a unique random secret of at least 32 bytes.
# Do not use a published example key. See README.md for the generation command.
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# ─── Development Overrides ──────────────────────────────────────────────────
# Bearer tokens are required by default. Opt in only for isolated local mocks.
# NOTE: This setting is automatically ignored and forced to FALSE in production.
ALLOW_DEV_AUTH_OVERRIDE=false

# ─── API Request Limits (per IP, per Node process) ───────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=30
